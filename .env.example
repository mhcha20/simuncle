# ── Core ─────────────────────────────────────────────
NODE_ENV=production
# Public site address, no trailing slash. Used for Google login + emailed links.
PUBLIC_URL=https://simuncle.com
# Random string, 32+ characters:  openssl rand -hex 32
JWT_SECRET=
# MySQL connection string. On Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=

# ── Login ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Authorised redirect URI: https://simuncle.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that always get admin access
ADMIN_EMAILS=
# Where owner notifications (new orders, sync failures, ...) are emailed. Defaults to the first ADMIN_EMAILS.
OWNER_EMAIL=

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=

# ── Payments (Stripe) ────────────────────────────────
# Use the LIVE key in production: reconciliation skips sessions from the other mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── eSIM suppliers ───────────────────────────────────
VIZLYNC_API_KEY=
VIZLYNC_PARTNER_ID=
TGT_API_BASE_URL=
TGT_ACCOUNT_ID=
# Also used to verify TGT callback signatures
TGT_SECRET=

# ── File storage (Cloudflare R2 or any S3-compatible bucket) ──
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public bucket URL. Leave empty to serve files through the app.
S3_PUBLIC_URL=

# ── AI (translations, SEO articles, support chat) ────
LLM_API_KEY=
# Optional; defaults to claude-sonnet-5-5
LLM_MODEL=

# ── Scheduled jobs ───────────────────────────────────
# Optional shared secret for calling /api/scheduled/* from outside (Authorization: Bearer ...).
# The built-in scheduler works without it.
CRON_SECRET=
# Run only these jobs (comma-separated names from server/scheduler.ts). Empty = all jobs.
SCHEDULER_JOBS=
# Set to 1 to stop the built-in scheduler (only if an external cron calls the endpoints instead)
DISABLE_SCHEDULER=

# ── Push notifications (keep the SAME keys as the old site or existing subscribers stop receiving) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY; needed at BUILD time
VITE_VAPID_PUBLIC_KEY=

# ── SEO / content services ───────────────────────────
SE_RANKING_API_KEY=
SE_RANKING_PROJECT_TOKEN=
SORO_REFRESH_TOKEN=
SORO_SUPABASE_ANON_KEY=
SORO_EMBED_TOKEN=
INDEXNOW_KEY=

# ── Analytics (optional) ─────────────────────────────
# Tracking script, needed at BUILD time. Umami Cloud: https://cloud.umami.is/script.js
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
# For the monthly report. Umami Cloud: https://api.umami.is/v1 (+ UMAMI_API_KEY); self-hosted: https://your-umami/api
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=
